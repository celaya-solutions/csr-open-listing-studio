{
  "name": "open-listing-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n ui,api -c cyan,green \"vite\" \"tsx watch src/server/node.ts\"",
    "build": "vite build",
    "start": "tsx src/server/node.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "db:export": "tsx scripts/export-db.ts"
  },
  "dependencies": {
    "@clawnify/connections": "^0.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^0.19.10",
    "@tailwindcss/vite": "^4.2.2",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "workerd"
